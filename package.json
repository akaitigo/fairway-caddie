{
	"name": "fairway-caddie",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "npx playwright test",
		"lint": "oxlint . && biome check .",
		"lint:fix": "oxlint --fix . && biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@playwright/test": "^1.61.1",
		"@types/d3": "^7.4.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^2.1.0",
		"oxlint": "^1.71.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"d3": "^7.9.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.7"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
